#include <behaviors/num_word.dtsi> // Requires zmk-auto-layer module.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Extend num_word continue-list with underscore, not needed ATM
// because the num layer contains _ already.
// &num_word {
//     continue-list = <BACKSPACE DELETE DOT COMMA PLUS MINUS STAR FSLH EQUAL UNDERSCORE>;
// };

/ {
    behaviors {
        lhm: lhm {
            compatible = "zmk,behavior-hold-tap";
            label = "LHM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 38 39 40 41 37 36 8>;
            hold-trigger-on-release;
        };

        rhm: rhm {
            compatible = "zmk,behavior-hold-tap";
            label = "RHM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        kp_hold_caps_word: kp_hold_caps_word {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_HOLD_CAPS_WORD";
            bindings = <&kp>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        kp_hold_num_word: kp_hold_num_word {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_HOLD_NUM_WORD";
            bindings = <&kp>, <&num_word>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        cmb_inner_thumbs {
            bindings = <&mo 4>;
            key-positions = <38 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "base";
            bindings = <
&kp ESCAPE  &kp Q        &kp W         &kp E             &kp R         &kp T                                    &kp Y                             &kp U               &kp I            &kp O         &kp P           &kp BSPC
&kp TAB     &lhm LALT A  &lhm LCTRL S  &lhm LGUI D       &lhm LSHFT F  &kp G                                    &kp H                             &rhm RIGHT_SHIFT J  &rhm RGUI K      &rhm RCTRL L  &rhm RALT SEMI  &kp SQT
&kp GRAVE   &kp Z        &kp X         &kp C             &kp V         &kp B                                    &kp N                             &kp M               &kp COMMA        &kp DOT       &kp FSLH        &kp MINUS
                                       &lt 1 LEFT_ARROW  &lt 2 RET     &kp_hold_caps_word LS(LA(LC(LGUI))) 0    &kp_hold_num_word LA(LC(LGUI)) 1  &lt 3 SPACE         &kp RIGHT_ARROW
            >;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans    &kp ASTERISK  &mt LG(N7) N7  &mt LG(N8) N8  &mt LG(N9) N9  &mt LG(MINUS) MINUS  &trans
&trans  &trans  &trans     &trans     &trans     &trans    &kp SLASH     &mt LG(N4) N4  &mt LG(N5) N5  &mt LG(N6) N6  &mt LG(PLUS) PLUS    &trans
&trans  &trans  &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans    &kp EQUAL     &mt LG(N1) N1  &mt LG(N2) N2  &mt LG(N3) N3  &trans               &trans
                           &trans     &trans     &trans    &trans        &kp DOT        &mt LG(N0) N0
            >;

            label = "NUM";
        };

        Navigation {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "NAV";
            bindings = <
&trans  &mt F11 F1  &mt F12 F2  &kp F3  &kp F4  &kp F5    &kp F6          &kp F7               &kp F8                 &kp F9           &kp F10  &trans
&trans  &trans      &trans      &trans  &trans  &trans    &rhm HOME LEFT  &rhm PAGE_DOWN DOWN  &rhm PAGE_UP UP_ARROW  &rhm END RIGHT   &trans   &trans
&trans  &trans      &trans      &trans  &trans  &trans    &trans          &kp K_MUTE           &kp C_VOLUME_DOWN      &kp C_VOLUME_UP  &trans   &trans
                                &trans  &trans  &trans    &trans          &trans               &trans
            >;

            label = "NAV";
        };

        Symbol {
            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN           &kp POUND             &kp DOLLAR                        &kp PERCENT         &kp CARET          &kp AMPERSAND                       &kp ASTERISK           &kp LEFT_PARENTHESIS     &kp RIGHT_PARENTHESIS       &none
&none      &lhm LALT PIPE   &lhm LCTRL LESS_THAN  &lhm LGUI LEFT_BRACE  &lhm LEFT_SHIFT LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &rhm RIGHT_SHIFT RIGHT_PARENTHESIS  &rhm RGUI RIGHT_BRACE  &rhm RCTRL GREATER_THAN  &rhm RALT NON_US_BACKSLASH  &kp UNDERSCORE
&kp TILDE  &none            &none                 &none                 &none                             &kp UNDERSCORE      &kp EQUAL          &none                               &none                  &none                    &kp SLASH                   &kp MINUS
                                                  &trans                &trans                            &trans              &trans             &trans                              &trans
            >;

            label = "SYM";
        };

        System {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "sys";
            bindings = <
&none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none        &none   &none   &none  &bt BT_CLR  &bt BT_CLR_ALL
&none       &none         &none         &none         &none         &none           &none        &none   &none   &none  &none       &none
&sys_reset  &none         &none         &none         &none         &bootloader     &bootloader  &none   &none   &none  &none       &sys_reset
                                        &trans        &trans        &trans          &trans       &trans  &trans
            >;

            label = "SYS";
        };
    };
};
